# Скопируйте в docker/.env и подставьте значения.
# Использование: docker compose -f docker-compose.prod.yml --env-file docker/.env up -d --build

POSTGRES_PASSWORD=сгенерируйте_длинный_пароль

BETTER_AUTH_SECRET=сгенерируйте_строку_минимум_32_символа
# Публичный URL API с префиксом /api (как в nginx)
BETTER_AUTH_URL=https://ваш-домен.ru/api/auth
# Origin фронта (без /api). При CORS_ORIGIN=true всё равно подхватится из BETTER_AUTH_URL
# BETTER_AUTH_TRUSTED_ORIGINS=https://ваш-домен.ru
# Для IP: http://212.57.115.28:8080

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Atlas <noreply@ваш-домен.ru>

# Порт HTTP снаружи (внутри nginx всегда 80)
HTTP_PORT=8080

# Опционально: если фронт и API на разных доменах — укажите URL фронта
# CORS_ORIGIN=https://app.example.com

# TRADING_DAY_CRON_DISABLED=true
# ALL = весь каталог CryptocurrencyList; либо CSV whitelist
# TRADING_DAY_SYMBOLS=ALL

# Макрокалендарь: ключ RapidAPI (подписка на economic-calendar-api-tradingeconomics)
# RAPIDAPI_KEY=
# RAPIDAPI_KEY_SECONDARY=
# RAPIDAPI_PROXY_URL=http://user:pass@host:port
# RAPIDAPI_HOST=economic-calendar-api-tradingeconomics.p.rapidapi.com

# FRED_API_KEY=
# BONDS_YIELD_CRON_DISABLED=true
