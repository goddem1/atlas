# Опционально в dev: если не задано, запросы идут через прокси Vite `/api` → API :3001.
# Задайте полный URL, если нужен другой хост (staging, другой порт).
# VITE_API_URL="http://localhost:3001"

# Локально: скройте Telegram-новости, если они настроены только на сервере
VITE_TELEGRAM_DISABLED=true
