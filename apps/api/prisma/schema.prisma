generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dashboards      Dashboard[]
  portfolioAssets PortfolioAsset[]
  klineChartPrefs UserKlineChartPrefs?
  klineChartOverlays UserKlineChartOverlays[]
  klineChartIndicators UserKlineChartIndicators[]
  sessions        Session[]
  accounts        Account[]
  notes           Note[]
  trades          Trade[]
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  direction   String
  entryPrice  Decimal  @db.Decimal(24, 8)
  exitPrice   Decimal  @db.Decimal(24, 8)
  quantity    Decimal  @db.Decimal(24, 8)
  quantityUnit String  @default("coins")
  entryAt     DateTime
  exitAt      DateTime?
  commission  Decimal  @default(0) @db.Decimal(24, 8)
  fundingFee  Decimal  @default(0) @db.Decimal(24, 8)
  reason      String?
  comment     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exitAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Без названия")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model UserKlineChartPrefs {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawingToolPins Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("UserKlineChartPrefs")
}

model UserKlineChartOverlays {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair      String
  overlays  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, pair])
  @@index([userId])
  @@map("UserKlineChartOverlays")
}

model UserKlineChartIndicators {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair       String
  indicators Json     @default("{\"main\":[],\"sub\":[]}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, pair])
  @@index([userId])
  @@map("UserKlineChartIndicators")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Dashboard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("My Dashboard")
  isDefault Boolean  @default(false)
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DashboardTemplate {
  id       String @id @default(cuid())
  name     String
  category String
  layout   Json
}

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  title       String
  content     String
  publishedAt DateTime
}

/// Справочник криптовалют проекта (иконки и прочие ресурсы).
model CryptocurrencyList {
  id         String  @id @default(cuid())
  symbol     String  @unique
  name       String
  iconUrl    String
  pairSymbol String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("CryptocurrencyList")
}

/// Дневные свечи с Binance klines (data-api.binance.vision). Дубликаты по одной свече исключены.
model CryptoPriceCandle {
  id       String   @id @default(cuid())
  symbol   String
  interval String   @default("1d") @map("interval")
  openTime DateTime
  open     Decimal  @db.Decimal(28, 12)
  high     Decimal  @db.Decimal(28, 12)
  low      Decimal  @db.Decimal(28, 12)
  close    Decimal  @db.Decimal(28, 12)
  volume   Decimal  @db.Decimal(38, 12)

  @@unique([symbol, interval, openTime])
  @@map("CryptoPriceCandle")
}

/// Цены закрытия облигаций по интервалам.
model BondsPrices {
  id        String   @id @default(cuid())
  symbol    String
  interval  String   @default("1d") @map("interval")
  closeTime DateTime
  close     Decimal  @db.Decimal(28, 12)

  @@unique([symbol, interval, closeTime])
  @@map("BondsPrices")
}

/// Счётчик запросов RapidAPI (TradingView bonds) по месяцам для ротации ключей.
model RapidApiBondsUsage {
  id           String   @id @default(cuid())
  provider     String
  monthKey     String
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([provider, monthKey])
  @@map("RapidApiBondsUsage")
}

model PortfolioAsset {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        PortfolioGoal[]

  @@unique([userId, symbol])
}

model Transaction {
  id             String          @id @default(cuid())
  portfolioAsset PortfolioAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String
  type           TransactionType
  date           DateTime
  priceUsd       Decimal         @db.Decimal(28, 12)
  amountCoins    Decimal         @db.Decimal(28, 12)
  amountUsd      Decimal         @db.Decimal(28, 12)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PortfolioGoal {
  id             String         @id @default(cuid())
  portfolioAsset PortfolioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String
  targetPriceUsd Decimal        @db.Decimal(28, 12)
  sellCoins      Decimal        @default(0) @db.Decimal(28, 12)
  createdAt      DateTime       @default(now())
}

/// База справочника макро-индикаторов (англ. референс).
model MacroIndicator {
  id          String   @id @default(cuid())
  name        String
  category    String
  country     String
  source      String
  unit        String
  frequency   String
  importance  String
  description String?
  createdAt   DateTime @default(now())

  dataPoints   MacroDataPoint[]
  translations MacroIndicatorTranslation[]
}

/// Переводы полей макро-индикатора по локали (по одному на locale).
model MacroIndicatorTranslation {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  category    String
  country     String
  unit        String
  frequency   String
  description String?

  @@unique([indicatorId, locale])
}

/// Исторические значения и будущие публикации макро-индикаторов.
model MacroDataPoint {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  date        DateTime
  actual      Decimal?
  forecast    Decimal?
  previous    Decimal?
  reference   String?
  isPending   Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([indicatorId, date])
  @@index([date, isPending])
}

enum TransactionType {
  BUY
  SELL
}

/// Каналы, которые сервер слушает / синкает для новостного ридера.
model TelegramWatchedChannel {
  username   String    @id
  title      String?
  hasPhoto   Boolean   @default(false)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  posts      TelegramNewsPost[]

  @@map("TelegramWatchedChannel")
}

/// Текст постов Telegram (медиа — по запросу через MTProto, не в БД).
model TelegramNewsPost {
  id              String   @id @default(cuid())
  channelUsername String
  channel         TelegramWatchedChannel @relation(fields: [channelUsername], references: [username], onDelete: Cascade)
  messageId       Int
  date            DateTime
  text            String   @db.Text
  entities        Json     @default("[]")
  views           Int?
  forwards        Int?
  isForwarded     Boolean  @default(false)
  hasMedia        Boolean  @default(false)
  hasImage        Boolean  @default(false)
  hasVideo        Boolean  @default(false)
  hasVideoThumb   Boolean  @default(false)
  videoSize       Int?
  mediaType       String?
  url             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([channelUsername, messageId])
  @@index([channelUsername, date(sort: Desc)])
  @@index([channelUsername, messageId(sort: Desc)])
  @@map("TelegramNewsPost")
}

/// Дневной индекс сентимента новостей (МСК-день) — для графика истории.
model TelegramNewsDailyIndex {
  /// Календарный день Europe/Moscow, YYYY-MM-DD
  day            String   @id
  /// Индекс 0–100
  sentiment      Int
  formula        String   @db.Text
  candidateCount Int      @default(0)
  /// Каналы, по которым считали
  usernames      Json     @default("[]")
  /// Топ-5: [{ id, why, impact, kind? }]
  topItems       Json     @default("[]")
  /// llm | heuristic
  source         String
  model          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([day(sort: Desc)])
  @@map("TelegramNewsDailyIndex")
}

/// Обратная связь автора по отбору новостей (few-shot калибровка для LLM).
model NewsPickFeedback {
  id                   String   @id @default(cuid())
  postKey              String   @unique
  day                  String
  postText             String   @db.Text
  postTimestamp        DateTime
  source               String

  llmWeight            Int?
  llmPolarity          Int?
  llmType              String?
  llmCategory          String?
  llmHeadline          String?

  humanWeight          Int?
  humanPolarity        Int?
  humanType            String?
  humanCorrect         Boolean?
  humanNote            String   @db.Text

  priceMoveBtc         Float?
  priceMoveEth         Float?
  priceMoveWindowHours Int?

  embedding            Float[]
  embeddingModel       String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([day])
  @@map("NewsPickFeedback")
}

/// Ежедневный снимок рыночных индексов CoinMarketCap (МСК-день).
model CmcDailySnapshot {
  id        String   @id @default(cuid())
  day       String   @unique

  fearGreedValue            Int
  fearGreedClassification   String

  btcDominance     Decimal @db.Decimal(28, 12)
  ethDominance     Decimal @db.Decimal(28, 12)
  totalMarketCap   Decimal @db.Decimal(28, 2)
  altcoinMarketCap Decimal @db.Decimal(28, 2)

  btcMarketCap     Decimal @db.Decimal(28, 2)
  ethMarketCap     Decimal @db.Decimal(28, 2)
  total3MarketCap  Decimal @db.Decimal(28, 2)

  altcoinSeasonIndex       Int
  altcoinSeasonMarketCap   Decimal? @db.Decimal(28, 2)

  fundingRates Json

  createdAt DateTime @default(now())

  @@index([day(sort: Desc)])
  @@map("CmcDailySnapshot")
}

/// Дневные бары рыночных индексов (TradingView RapidAPI, историческая загрузка).
model MarketIndexDailyBar {
  id       String   @id @default(cuid())
  indexId  String
  interval String   @default("1d")
  day      String
  openTime DateTime
  open     Decimal? @db.Decimal(28, 12)
  high     Decimal? @db.Decimal(28, 12)
  low      Decimal? @db.Decimal(28, 12)
  close    Decimal  @db.Decimal(28, 12)
  volume   Decimal? @db.Decimal(38, 12)

  @@unique([indexId, interval, openTime])
  @@index([indexId, openTime(sort: Desc)])
  @@map("MarketIndexDailyBar")
}

/// Дневная история Fear & Greed Index (CoinMarketCap data-api).
model FearGreedDailyBar {
  id             String   @id @default(cuid())
  day            String   @unique
  score          Int
  classification String
  barTime        DateTime
  btcPrice       Decimal? @db.Decimal(28, 12)
  btcVolume      Decimal? @db.Decimal(38, 12)

  @@index([barTime(sort: Desc)])
  @@map("FearGreedDailyBar")
}
