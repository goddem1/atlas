generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dashboards      Dashboard[]
  portfolioAssets PortfolioAsset[]
  sessions        Session[]
  accounts        Account[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Dashboard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("My Dashboard")
  isDefault Boolean  @default(false)
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DashboardTemplate {
  id       String @id @default(cuid())
  name     String
  category String
  layout   Json
}

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  title       String
  content     String
  publishedAt DateTime
}

/// Справочник криптовалют проекта (иконки и прочие ресурсы).
model CryptocurrencyList {
  id         String  @id @default(cuid())
  symbol     String  @unique
  name       String
  iconUrl    String
  pairSymbol String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("CryptocurrencyList")
}

/// Дневные свечи с Binance klines (data-api.binance.vision). Дубликаты по одной свече исключены.
model CryptoPriceCandle {
  id       String   @id @default(cuid())
  symbol   String
  interval String   @default("1d") @map("interval")
  openTime DateTime
  open     Decimal  @db.Decimal(28, 12)
  high     Decimal  @db.Decimal(28, 12)
  low      Decimal  @db.Decimal(28, 12)
  close    Decimal  @db.Decimal(28, 12)
  volume   Decimal  @db.Decimal(38, 12)

  @@unique([symbol, interval, openTime])
  @@map("CryptoPriceCandle")
}

/// Цены закрытия облигаций по интервалам.
model BondsPrices {
  id        String   @id @default(cuid())
  symbol    String
  interval  String   @default("1d") @map("interval")
  closeTime DateTime
  close     Decimal  @db.Decimal(28, 12)

  @@unique([symbol, interval, closeTime])
  @@map("BondsPrices")
}

/// Счётчик запросов RapidAPI (TradingView bonds) по месяцам для ротации ключей.
model RapidApiBondsUsage {
  id           String   @id @default(cuid())
  provider     String
  monthKey     String
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([provider, monthKey])
  @@map("RapidApiBondsUsage")
}

model PortfolioAsset {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        PortfolioGoal[]

  @@unique([userId, symbol])
}

model Transaction {
  id             String          @id @default(cuid())
  portfolioAsset PortfolioAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String
  type           TransactionType
  date           DateTime
  priceUsd       Decimal         @db.Decimal(28, 12)
  amountCoins    Decimal         @db.Decimal(28, 12)
  amountUsd      Decimal         @db.Decimal(28, 12)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PortfolioGoal {
  id             String         @id @default(cuid())
  portfolioAsset PortfolioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId        String
  targetPriceUsd Decimal        @db.Decimal(28, 12)
  sellCoins      Decimal        @default(0) @db.Decimal(28, 12)
  createdAt      DateTime       @default(now())
}

/// База справочника макро-индикаторов (англ. референс).
model MacroIndicator {
  id          String   @id @default(cuid())
  name        String
  category    String
  country     String
  source      String
  unit        String
  frequency   String
  importance  String
  description String?
  createdAt   DateTime @default(now())

  dataPoints   MacroDataPoint[]
  translations MacroIndicatorTranslation[]
}

/// Переводы полей макро-индикатора по локали (по одному на locale).
model MacroIndicatorTranslation {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  category    String
  country     String
  unit        String
  frequency   String
  description String?

  @@unique([indicatorId, locale])
}

/// Исторические значения и будущие публикации макро-индикаторов.
model MacroDataPoint {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   MacroIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  date        DateTime
  actual      Decimal?
  forecast    Decimal?
  previous    Decimal?
  reference   String?
  isPending   Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([indicatorId, date])
  @@index([date, isPending])
}

enum TransactionType {
  BUY
  SELL
}
