{
  "name": "@atlas-v1/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "load:bonds-fred": "tsx src/scripts/loadBondsPricesFred.ts",
    "bonds:refresh-tv": "tsx src/scripts/refreshBondsYieldTv.ts",
    "bonds:refresh-fred": "tsx src/scripts/refreshBondsYieldFred.ts",
    "load:candles": "tsx src/scripts/loadCryptoCandles.ts",
    "load:candles:all": "tsx src/scripts/loadAllCandlesHistorical.ts",
    "macro:import-range": "tsx src/scripts/importMacroCalendarRange.ts",
    "macro:prefetch-next-two-months": "tsx src/scripts/prefetchMacroNextTwoMonths.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@atlas-v1/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.1.0",
    "better-auth": "^1.2.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^4.2.1",
    "resend": "^4.5.1",
    "sharp": "^0.34.5",
    "undici": "^6.21.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
