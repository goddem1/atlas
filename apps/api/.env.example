# После изменения prisma/schema.prisma: из корня pnpm db:push (или из apps/api: pnpm db:push)
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas_v1?schema=public"
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Better Auth (минимум 32 символа для secret)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Публичный URL Better Auth (в dev: Vite /api → API, маршруты /auth/*)
BETTER_AUTH_URL="http://localhost:5173/api/auth"

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Resend: https://resend.com/api-keys
# С onboarding@resend.dev письма уходят ТОЛЬКО на email владельца аккаунта Resend.
# Для @mail.ru, @yandex.ru и любых других — верифицируйте домен: resend.com/domains
RESEND_API_KEY=""
RESEND_FROM="Atlas <onboarding@resend.dev>"

# Одноразовая загрузка свечей: pnpm run load:candles (из каталога apps/api, нужен DATABASE_URL)
# SYMBOL=BTCUSDT
# SYMBOLS=BTCUSDT,ETHUSDT,HBARUSDT,SUIUSDT,PEPEUSDT
# START_MS=1514764800000
# LOAD_CANDLES_CONCURRENCY=3
# LOAD_CANDLES_DELAY_MS=150

# Ежедневно в 00:00:01 MSK: tradingDay → таблица CryptoPriceCandle (interval 1d)
# ALL / * / пусто → весь CryptocurrencyList; иначе CSV whitelist
# TRADING_DAY_SYMBOLS=ALL
# TRADING_DAY_CRON_DISABLED=true

# WebSocket стриминг Binance для live-свечи текущего MSK-дня
# BINANCE_WS_DISABLED=true

# FRED: pnpm run load:bonds-fred (в apps/api) — DGS30 → BondsPrices (symbol 30Y)
# FRED_API_KEY="your_fred_key"
# FRED_SERIES_ID=DGS30
# BONDS_SYMBOL=30Y
# BONDS_INTERVAL=1D
# FRED_OBSERVATION_START=2026-05-22
# FRED_OBSERVATION_END=2026-05-28

# Прокси для внешних запросов к календарю (формат host:port:user:pass или URL)
# RAPIDAPI_PROXY_URL="http://user:pass@127.0.0.1:8000"

# RAPIDAPI_KEY=
# RAPIDAPI_KEY_SECONDARY=
# RAPIDAPI_HOST=economic-calendar-api-tradingeconomics.p.rapidapi.com

# Telegram news reader (GramJS MTProto) — полноэкранная модалка каналов
# Получить api_id/api_hash: https://my.telegram.org/apps
# Затем: cd apps/api && pnpm telegram:auth → вставить TELEGRAM_SESSION
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# TELEGRAM_CHANNELS=cryptoattack24,markettwits
# TELEGRAM_NEWS_SYNC_DISABLED=false
# Catch-up interval (minutes) in addition to live MTProto events
# TELEGRAM_NEWS_CATCHUP_MINUTES=5
# Optional retention; 0 = keep forever (accumulate forward)
# TELEGRAM_NEWS_RETENTION_DAYS=0
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=
# TELEGRAM_PROXY_PORT=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=

# LLM для news-виджета (Polza.ai, OpenAI-compatible) — один вызов/день в 23:00 МСК → БД
# LLM_API_KEY=
# LLM_BASE_URL=https://polza.ai/api/v1
# LLM_MODEL=openai/gpt-4o
# NEWS_WIDGET_LLM_DISABLED=false
# NEWS_WIDGET_LLM_CRON_DISABLED=false

# News feedback / calibration (owner-only routes; skip auth in non-production)
# NEWS_FEEDBACK_OWNER_EMAIL=you@example.com
# NEWS_FEEDBACK_SKIP_AUTH=true
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# NEWS_FEEDBACK_FEWSHOT_COUNT=8
# NEWS_FEEDBACK_MIN_SIMILARITY=0.75
# NEWS_FEEDBACK_PRICE_HINT_WINDOW_HOURS=4

# Кривая ФРС: ежедневно 15:00 MSK — TradingView (актуально), 15:15 MSK — FRED (точнее, с лагом)
# BONDS_YIELD_CRON_DISABLED=true
# Лимит RapidAPI на один ключ (запросов/мес). Крон TV: 11 теноров × ~22 дня ≈ 242 запроса/мес — нужен второй ключ или выше лимит.
# RAPIDAPI_BONDS_MONTHLY_LIMIT=150
# BONDS_TV_REQUEST_DELAY_MS=1300
# На сервере в РФ: RAPIDAPI_PROXY_URL=... (TV bonds идут через прокси автоматически)
# BONDS_TV_DIRECT=true — только локально, без прокси
# BONDS_FRED_LOOKBACK_DAYS=21
